# =========================================================================
# LO2TAA (لقطة) - Environment Variables Configuration
# =========================================================================

# 1. Database (Supabase PostgreSQL / Vercel Postgres)
# Paste your Supabase project URL and service role secret or anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Direct PostgreSQL connection string (if using Vercel Postgres / Neon)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# 2. Vercel Cron Secret (Authentication for scheduled price updates)
# Matches Vercel's automated Authorization header in production
CRON_SECRET=your-random-secure-cron-secret-here

# 3. Amazon Associates Affiliate Configuration
# Your official Amazon Egypt Associate Tracking Tag (default: lo2taa-21)
AFFILIATE_TAG=lo2taa-21

# 4. Amazon Creators / PA-API v5 (Optional - Legal Official API)
# If provided, LO2TAA automatically switches to official Amazon PA-API
AMAZON_PAAPI_KEY=
AMAZON_PAAPI_SECRET=
AMAZON_PAAPI_TAG=lo2taa-21
AMAZON_PAAPI_ENDPOINT=https://webservices.amazon.eg/paapi5/getitems

# 5. Price Alerts Notifications
# Resend API Key for sending clean transactional price drop emails
RESEND_API_KEY=re_your_resend_api_key_here
ALERT_FROM_EMAIL=alerts@lo2taa.com

# Telegram Bot Token for price drop alerts channel/bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@lo2taa

# 6. Admin Dashboard Protection
# Password required to access /admin
ADMIN_PASSWORD=lo2taa-admin-secret-2026
